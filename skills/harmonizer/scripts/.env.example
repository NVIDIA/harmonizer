#
# Copy this OUTSIDE the checkout, owner-readable only, and fill in real
# values, e.g.
#   install -m 600 scripts/.env.example ~/.harmonizer.env
#   set -a && . ~/.harmonizer.env && set +a
#
# Use `install -m 600` (or `umask 077` then `chmod 600`) rather than a plain
# `cp`: this template is mode 0664, so a copy would leave your live tokens
# readable by every local user.
#
# Do NOT place the filled-in file inside the repository. Dockerfile.cosmos
# does `COPY . /harmonizer-codebase` and there is no .dockerignore here, so
# any file in the checkout is sent to the Docker daemon (or a remote builder)
# and kept in build cache. Adding a .gitignore does not prevent that — it
# scopes git, not build context. NEVER commit this file with real tokens.

# Hugging Face token with read access to nvidia/Harmonizer,
# nvidia/Cosmos-Predict2-0.6B-Text2Image, and (if used)
# nvidia/Harmonizer-Dataset. Accept the model/dataset license terms in
# the browser before downloading gated artifacts.
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_me

# Optional but commonly needed for `docker login nvcr.io` before pulling
# the nvcr.io/nvidia/pytorch:25.10-py3 base image (or other NVIDIA NGC
# containers). Username must be the literal string `$oauthtoken`.
# Create at: https://ngc.nvidia.com/setup/personal-keys
NGC_API_KEY=nvapi-replace-me
